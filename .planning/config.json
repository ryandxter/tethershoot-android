{
  "aas_integration": true,
  "aas_version": "15.12.0",
  "gsd_core_version": "latest",
  "graphify": {
    "enabled": true,
    "auto_update": true
  },
  "parallelization": true,
  "workflow": {
    "inline_plan_threshold": 0,
    "use_worktrees": true,
    "subagent_timeout": 600000,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "nyquist_validation": true,
    "pattern_mapper": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": false,
    "code_review": true,
    "code_review_depth": "standard",
    "ui_review": true,
    "text_mode": false,
    "research_before_questions": false,
    "skip_discuss": false
  },
  "worktree": {
    "baseRef": "head"
  },
  "model_profile": "adaptive",
  "commit_docs": true,
  "plan_review": {
    "source_grounding": true
  },
  "intel": {
    "enabled": false
  },
  "git": {
    "branching_strategy": "none",
    "create_tag": true
  }
}